# 应用配置
NODE_ENV=development
PORT=3000
APP_NAME=TVBox Backend

# 数据库配置
DB_TYPE=better-sqlite3
DB_DATABASE=./data/tvbox.db
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Spider 配置
SPIDER_TIMEOUT=10000
SPIDER_MEMORY_LIMIT=128
SPIDER_CONCURRENT_LIMIT=5

# 缓存配置
CACHE_TTL=3600
CACHE_MAX_ITEMS=1000

# 日志配置
LOG_LEVEL=debug

# API 配置
API_PREFIX=/api/v1
API_VERSION=1.0

# 安全配置
AUTH_ENABLED=false
AUTH_SECRET=your-secret-key-here
